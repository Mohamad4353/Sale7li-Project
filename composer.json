{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "sale7li/platform",
  "type": "project",
  "description": "SALE7LI bilingual home services marketplace.",
  "keywords": ["laravel", "home-services", "marketplace", "bilingual", "rtl"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c \"#93c5fd,#fbbf24,#86efac\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=http,queue,vite"],
    "test": ["@php artisan config:clear", "@php artisan test"]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
