# ─────────────────────────────────────────────────────────────────────────────
# SALE7LI environment template.
#
# Copy to `.env` for local development. For a real deployment follow
# docs/DEPLOYMENT.md — production MUST set: APP_ENV=production, APP_DEBUG=false,
# APP_URL=https://<domain>, a strong APP_KEY (php artisan key:generate), real
# database + mail credentials, SESSION_SECURE_COOKIE=true, and TRUSTED_PROXIES
# if a reverse proxy / load balancer terminates TLS.
#
# Never commit a real .env, APP_KEY, database password, or SMTP credentials.
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=SALE7LI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Production: set LOG_LEVEL=warning (or error). The default `single` channel does
# not rotate — use OS logrotate, or a `daily` channel, in production.
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Production uses MySQL — replace the two lines above with:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sale7li
# DB_USERNAME=sale7li
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Must be true in production (HTTPS). Auto-true when APP_ENV=production.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# ── Reverse proxy / trusted proxies ──────────────────────────────────────────
# Comma-separated proxy IP(s) / CIDR range(s) whose X-Forwarded-* headers the app
# should trust (e.g. "10.0.0.0/8,192.0.2.10"), or "*" ONLY when the app is
# reachable exclusively through the proxy. Empty = trust nothing (the safe
# default): forwarded headers are ignored and HSTS is only emitted on a genuine
# HTTPS connection. Required behind a TLS-terminating load balancer / ingress so
# that request->secure() and HSTS behave correctly. See docs/DEPLOYMENT.md.
TRUSTED_PROXIES=

# ── Mail ─────────────────────────────────────────────────────────────────────
# MAIL_MAILER=log is DEVELOPMENT/TESTING ONLY — messages are written to
# storage/logs/laravel.log and never delivered.
#
# Production REQUIRES a real transport. Email verification and password reset
# both depend on working outbound mail; with `log` a real user can register but
# can never verify their address (and so can never book) or reset a password.
# Mail is sent synchronously (no queue) — use a responsive provider.
#
# Example production SMTP block (supply credentials via env/secrets, never here):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.your-provider.example
#   MAIL_PORT=587
#   MAIL_USERNAME=
#   MAIL_PASSWORD=
#   MAIL_SCHEME=          # blank = auto (STARTTLS on 587, TLS on 465); or smtps
#   MAIL_FROM_ADDRESS="no-reply@your-domain.example"
#   MAIL_FROM_NAME="${APP_NAME}"
# A hosted API transport (ses / postmark / resend / mailgun) is also supported —
# see the framework mail config and docs/DEPLOYMENT.md.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sale7li.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Application ──────────────────────────────────────────────────────────────
# "Contact support" destinations. Blank falls back to the config defaults.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# Manual WHISH payment (no gateway integration): the customer transfers to this
# account and submits the reference for an admin to verify. Real details go in
# the production environment, never in source.
WHISH_ACCOUNT_NAME=
WHISH_ACCOUNT_NUMBER=
WHISH_INSTRUCTIONS=

# ── AI Service Assistant (advisory only) ─────────────────────────────────────
# Gemini Developer API credentials for the customer-facing "describe your
# problem" category-suggestion assistant. Blank = the feature is unavailable;
# AiCategorySuggestionService fails closed and the booking flow is unaffected.
# Never commit a real key. GEMINI_MODEL falls back to a sane default in
# config/services.php when left blank.
GEMINI_API_KEY=
GEMINI_MODEL=
